{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "api/index.py"
    },
    {
      "src": "/api/webhook/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/api/bot/(.*)",
      "dest": "api/index.py"
    }
  ]
}
